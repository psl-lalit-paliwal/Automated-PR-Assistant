# Copy to .env and fill in. Never commit .env.

# Fine-grained GitHub token: read/write on repo contents and pull requests.
GITHUB_TOKEN=

# Target repository: https://github.com/<owner>/<repo>
GITHUB_OWNER=psl-lalit-paliwal
GITHUB_REPO=Automated-PR-Assistant

# Bob API key (bob.ibm.com, Scope = Inference). Needed for `bob run`.
BOB_API_KEY=
